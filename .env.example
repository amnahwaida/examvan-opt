EXAMVAN_SECRET=change-me-to-random-32-chars-min-CHANGE-IN-PROD-1234567890
EXAMVAN_SECRET_PREV=
EXAMVAN_ADMIN_USER=superadmin
EXAMVAN_ADMIN_PASS=super-secret-CHANGE-ME
DB_PASSWORD=change-me-db-pass
DATABASE_URL=postgresql://examvan:change-me-db-pass@db:5432/examvan
REDIS_URL=redis://redis:6379/0
R2_ACCESS_KEY_ID=your-r2-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=examvan-pdfs
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Fail-closed R2: 1 = upload PDF gagal → create exam dibatalkan (502).
# Jangan set 0 kecuali sengaja membolehkan exam tanpa file (dev only).
EXAMVAN_R2_STRICT=1
# MODE TEST HANYA: sukses-palsu upload R2 tanpa R2 nyata (test harness).
# JANGAN diaktifkan di produksi — file PDF tidak akan pernah terupload.
# EXAMVAN_R2_TESTMODE=1
DATABASE_MAX_CONNS=60
APP_ENV=production
PROTOBUF_MANDATORY=0
# Set 1 di produksi untuk wajib Protobuf (2c/8GB optimal, 40% byte lebih hemat, lihat docs/ARCHITECTURE_CPP_UWS_PROTOBUF.md)
